<%- include('partials/header') %>

    <main>
        <h1>
            <%= project.title %>
        </h1>

        <p>
            <%= project.description %>
        </p>

        <p>
            <strong>Date:</strong>
            <%= project.date ? new Date(project.date).toLocaleDateString() : 'No date available' %>
        </p>

        <p>
            <strong>Location:</strong>
            <%= project.location ? project.location : 'No location available' %>
        </p>

        <p>
            <strong>Organization:</strong>
            <a href="/organization/<%= project.organization_id %>">
                <%= project.organization_name %>
            </a>
        </p>

        <p>
            <strong>Categories:</strong>

            <% categories.forEach(category=> { %>

                <a href="/category/<%= category.category_id %>">
                    <%= category.category_name %>
                </a>

                <% }) %>
        </p>
        <p>
            <a href="/project/<%= project.project_id %>/assign-categories">
                Edit Categories
            </a>
        </p>
        <p>
            <a href="/edit-project/<%= project.project_id %>">
                Edit Project
            </a>
        </p>

    </main>

    <%- include('partials/footer') %>